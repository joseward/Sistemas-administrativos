# ============================================
# DATABASE - AZURE POSTGRESQL
# ============================================
# Formato Azure Database for PostgreSQL:
# postgresql://username@servername:password@servername.postgres.database.azure.com:5432/database?schema=public&sslmode=require

# Local Development:
DATABASE_URL="postgresql://postgres:password@localhost:5432/admin_escolar?schema=public"

# Azure Production (reemplaza con tus credenciales):
# DATABASE_URL="postgresql://adminuser@azureserver:your-strong-password@azureserver.postgres.database.azure.com:5432/admin_escolar?schema=public&sslmode=require"

# ============================================
# NEXT.JS CONFIGURATION
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3000
NODE_ENV=development

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
# JWT Secret - generar con: openssl rand -base64 32
# En producción, Azure Key Vault maneja esto
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Session Secret
SESSION_SECRET=your-session-secret-change-in-production

# ============================================
# AZURE CONFIGURATION (Producción)
# ============================================
# Azure App Service
# AZURE_RESOURCE_GROUP=your-resource-group
# AZURE_APP_SERVICE_NAME=your-app-service-name

# Azure Storage (para uploads de archivos)
# AZURE_STORAGE_ACCOUNT_NAME=yourstorageaccount
# AZURE_STORAGE_ACCOUNT_KEY=your-storage-key
# AZURE_STORAGE_CONTAINER=admin-escolar-files

# ============================================
# EMAIL CONFIGURATION (OPCIONAL)
# ============================================
# Para notificaciones a maestros sobre contratos y cambios de horario
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASSWORD=tu-app-password-gmail
SMTP_FROM=noreply@tuescuela.edu

# ============================================
# LOGGING & MONITORING
# ============================================
# Azure Application Insights
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# Logs
LOG_LEVEL=info

# ============================================
# FEATURES & FLAGS
# ============================================
# Habilitar envío de emails
ENABLE_EMAIL_NOTIFICATIONS=true

# Habilitar generación de PDFs
ENABLE_PDF_GENERATION=true
